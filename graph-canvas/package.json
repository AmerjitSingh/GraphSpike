{
  "name": "@graphspike/graph-canvas",
  "version": "1.0.0",
  "description": "A React component for node-edge graphs, rendered on canvas with a DOM layer for the node you're interacting with.",
  "author": "Amerjit Singh Brench",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "keywords": [
    "graph",
    "mindmap",
    "canvas",
    "d3",
    "force-layout",
    "react",
    "zustand",
    "nodes",
    "edges"
  ],
  "dependencies": {
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "rbush": "^4.0.1",
    "zustand": "^5.0.14"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.2.18",
    "typescript": "^7.0.2"
  },
  "sideEffects": false
}
